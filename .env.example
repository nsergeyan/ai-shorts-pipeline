# Copy this file to .env and fill in your keys
# Never commit .env to git

# Google Gemini: supports key rotation, comma-separated
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# ElevenLabs: voice synthesis and music generation
ELEVENLABS_API_KEY=your_elevenlabs_key

# TikTok Content Posting API (developers.tiktok.com app with Login Kit + Content Posting)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-site.example/callback
